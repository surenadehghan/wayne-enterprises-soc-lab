<!--
  Wayne Enterprises SOC Lab - Oracle's custom detection rules
  Deployed to the Wazuh manager at: /var/ossec/etc/rules/local_rules.xml

  Detection-as-code: these rules live in version control and are pulled
  onto the SIEM, so every change is tracked and reviewable.

  Custom rule IDs use the 100100-100199 range (reserved for the lab).
-->
<group name="gotham,sysmon,discovery,">

  <!--
    THE RIDDLER - High-value reconnaissance (MITRE T1087.002)

    Built-in Wazuh rules flag account discovery at level 3 (low). But a
    workstation enumerating the DOMAIN ADMINS group is a strong early
    warning: normal users never do this. We raise it to level 12 (high)
    so it stands out and would page an analyst.

    Base: Sysmon Event ID 1 (process creation, rule 61603) - fires for
    every process, including net.exe / net1.exe. The regex then isolates
    the specific "net group Domain Admins" reconnaissance command.
  -->
  <rule id="100100" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bnet1?\b.*\bgroup\b.*domain admins</field>
    <description>Oracle/Gotham: Domain Admins group enumeration on $(win.system.computer) - high-value reconnaissance (T1087.002)</description>
    <mitre>
      <id>T1087.002</id>
    </mitre>
    <group>attack,recon,gotham_critical,</group>
  </rule>

</group>
